# Copia este archivo como .env y pon tus llaves reales.
# El archivo .env nunca se sube al repositorio.

# Quién redacta las respuestas: "openrouter" (DeepSeek) o "anthropic" (Claude)
LLM_PROVIDER=openrouter

# OpenRouter (llave del hackathon, solo responde a este modelo)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Claude (opcional; solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Voyage (embeddings, siempre necesario)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Llave creada en MongoDB Atlas: https://ai.mongodb.com/v1
# Llave antigua creada en el sitio de Voyage: https://api.voyageai.com/v1
VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Servidor
PORT=3000
# Dominios que pueden llamar al API, separados por coma
CORS_ORIGIN=http://localhost:5173
# Límite de uso: preguntas por persona en cada ventana de segundos
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# RAG
# Umbral de similitud: abajo de este número no se llama al modelo.
# Preguntas completas: del tema ≥ 0.56, fuera ≤ 0.48. Preguntas cortas: se enciman entre 0.40 y 0.50,
# así que el modelo es el segundo filtro en esa zona (responde no_info si no está en las fuentes).
SIMILARITY_THRESHOLD=0.40
# Cuántos fragmentos se buscan por pregunta
TOP_K=5