# Copia este archivo como .env y pon tus llaves reales.
# El archivo .env nunca se sube al repositorio.

# Quién redacta las respuestas: "openrouter" (DeepSeek) o "anthropic" (Claude)
LLM_PROVIDER=openrouter

# OpenRouter (llave del hackathon, solo responde a este modelo)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Claude (opcional; solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Voyage (embeddings, siempre necesario)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Llave creada en MongoDB Atlas: https://ai.mongodb.com/v1
# Llave antigua creada en el sitio de Voyage: https://api.voyageai.com/v1
VOYAGE_BASE_URL=https://ai.mongodb.com/v1